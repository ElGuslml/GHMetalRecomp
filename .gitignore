# Game files: you provide your own (see assets/README.md)
assets/*
!assets/README.md

# Generated by the codegen during the build (only the CMake entry point is tracked)
generated/*
!generated/rexglue.cmake

# Build output
out/

# RenderDoc captures and their analysis (recomp-tools' tools/renderdoc, RECOMP_CAPTURES)
captures/

# Personal tools and data of this game: the XEX image (tools/image.bin), investigation scripts (not published;
# the shared tools are in recomp-tools)
tools/

# Claude Code instructions and personal notes (not published)
CLAUDE.md
CLAUDE.local.md

# Detailed investigation notes, per run (not published; the short public version is docs/)
local_docs/

*.log
